# Environment Configuration Template
# Copy this to .env.local and fill in your values
# NEVER commit .env.local to version control

# Server Configuration
NODE_ENV=development
PORT=5000

# JWT Configuration
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Demo User Credentials
# Override the default demo passwords for security
DEMO_EMAIL=mrpitzo@rhythmrockets.com
PASSWORD_MRPITZO_ADMIN=Rr!2026#Pitzo$Studio91

DEMO_MUSIC_EMAIL=music@rhythmrockets.com
PASSWORD_MRPITZO_MUSIC=Rhythm@Rockets#Create88

DEMO_DEV_EMAIL=dev@rhythmrockets.com
PASSWORD_PITZO_DEV=Build!AI$Studio2026#

# Database Configuration (Optional - for future use)
# DATABASE_URL=mongodb://localhost:27017/rhythm-rockets
# DATABASE_USER=admin
# DATABASE_PASSWORD=your-db-password

# API Keys (Optional)
# MUSIC_SERVICE_API_KEY=your-music-generation-service-key
# STORAGE_SERVICE_KEY=your-cloud-storage-key

# Feature Flags
ENABLE_2FA=false
ENABLE_OAUTH=false
ENABLE_AUDIT_LOGGING=false

# CORS Configuration
CORS_ORIGIN=http://localhost:3000,http://localhost:5173

# Security Headers
SECURITY_RATE_LIMIT=100
SECURITY_RATE_LIMIT_WINDOW=15
